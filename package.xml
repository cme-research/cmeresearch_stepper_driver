<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cmeresearch_stepper_driver</name>
  <version>0.1.0</version>
  <description>ROS 2 driver for the TinkerForge Silent Stepper Bricklet 2.0 (one node per wheel).</description>
  <maintainer email="info@cme-robotics.com">cme</maintainer>
  <license>GPLv3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>cmeresearch_msgs</depend>

  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
